@{
    ViewData["Title"] = "Board Game Page";
}

@model IEnumerable<Domain.BoardGame>

  <style>
    .font-color {
        color: #e3342f;
       
    }
    .font-color-2 {
         color: #0a5700;
    }
    .accessible-text {
        font-size: 1.5rem; /* Larger text for readability */
        line-height: 1.8; /* More spacing for easier reading */
        font-weight: 500; /* Medium weight for contrast */
    }
</style>

<section class="bg-white py-8 antialiased md:py-12">
  <div class="mx-auto max-w-screen-xl px-4 2xl:px-0">
    <!-- Heading & Filters -->
    <div class="mb-4 items-end justify-between space-y-4 sm:flex sm:space-y-0 md:mb-8">
      <div>
        <h2 class="mt-3 text-4xl font-extrabold font-color-2 sm:text-5xl">Game Night's</h2>
      </div>
      <div class="flex items-center space-x-4">
        <!-- Filter Button -->
        <div class="relative">
          <button id="filterDropdownButton" type="button" class="flex w-full items-center justify-center rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-900 hover:bg-gray-100 hover:text-primary-700 focus:z-10 focus:outline-none focus:ring-4 focus:ring-gray-100 sm:w-auto" aria-expanded="false">
            <svg class="-ms-0.5 me-2 h-4 w-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
              <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M18.796 4H5.204a1 1 0 0 0-.753 1.659l5.302 6.058a1 1 0 0 1 .247.659v4.874a.5.5 0 0 0 .2.4l3 2.25a.5.5 0 0 0 .8-.4v-7.124a1 1 0 0 1 .247-.659l5.302-6.059c.566-.646.106-1.658-.753-1.658Z" />
            </svg>
            Filters
          </button>
          <div id="filterDropdown" class="absolute right-0 hidden mt-2 w-48 bg-white border border-gray-200 shadow-lg rounded-lg z-10">
            <form class="p-4">
              <div class="mb-4">
                <label for="filterDate" class="block text-gray-700">Filter by Date:</label>
                <input type="date" id="filterDate" name="filterDate" class="w-full border px-4 py-2 mt-2">
              </div>
              <div class="mb-4">
                <label for="filterParticipants" class="block text-gray-700">Filter by Participants:</label>
                <input type="number" id="filterParticipants" name="filterParticipants" class="w-full border px-4 py-2 mt-2" placeholder="Min participants">
              </div>
              <div class="flex justify-end gap-4">
                <button type="button" class="px-4 py-2 bg-gray-500 text-white rounded" onclick="closeDropdown('filterDropdown')">Close</button>
                <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded">Apply</button>
              </div>
            </form>
          </div>
        </div>

        <!-- Sort Button -->
        <div class="relative">
          <button id="sortDropdownButton" type="button" class="flex w-full items-center justify-center rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-900 hover:bg-gray-100 hover:text-primary-700 focus:z-10 focus:outline-none focus:ring-4 focus:ring-gray-100 sm:w-auto" aria-expanded="false">
            <svg class="-ms-0.5 me-2 h-4 w-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M7 4l3 3M7 4 4 7m9-3h6l-6 6h6m-6.5 10 3.5-7 3.5 7M14 18h4" />
            </svg>
            Sort
          </button>
          <div id="sortDropdown" class="absolute right-0 hidden mt-2 w-48 bg-white border border-gray-200 shadow-lg rounded-lg z-10">
            <form class="p-4">
              <div class="mb-4">
                <label for="sortBy" class="block text-gray-700">Sort by:</label>
                <select id="sortBy" name="sortBy" class="w-full border px-4 py-2 mt-2">
                  <option value="date">Date</option>
                  <option value="participants">Participants</option>
                </select>
              </div>
              <div class="flex justify-end gap-4">
                <button type="button" class="px-4 py-2 bg-gray-500 text-white rounded" onclick="closeDropdown('sortDropdown')">Close</button>
                <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded">Apply</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <div class="mb-4 grid gap-4 sm:grid-cols-2 md:mb-8 lg:grid-cols-3 xl:grid-cols-4">
      <!-- Start of Card for Game Nights -->
      <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
        <div class="h-56 w-full">
          <a href="#">
            <img class="mx-auto h-full" src="https://flowbite.s3.amazonaws.com/blocks/e-commerce/imac-front.svg" alt="" />
            <img class="mx-auto hidden h-full" src="https://flowbite.s3.amazonaws.com/blocks/e-commerce/imac-front-dark.svg" alt="" />
          </a>
        </div>
        <div class="pt-6 border-t border-gray-200">
          <div class="mb-4 flex items-center justify-between gap-4">
            <span class="me-2 rounded bg-primary-100 px-2.5 py-0.5 text-s font-medium font-color-2">3/8 participants</span>
          </div>

          <a href="#" class="text-2xl font-semibold leading-tight text-red-600 hover:underline"></a>

          <ul class="mt-2 flex items-center gap-4">
            <li class="flex items-center gap-2">
              <svg class="h-8 w-8 text-gray-500" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h6l2 4m-8-4v8m0-8V6a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v9h2m8 0H9m4 0h2m4 0h2v-4m0 0h-5m3.5 5.5a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0Zm-10 0a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0Z" />
              </svg>
              <p class="text-2xl font-medium font-color-2">Date</p>
            </li>

            <li class="flex items-center gap-2">
              <svg class="h-8 w-8 font-color-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-width="2" d="M8 7V6c0-.6.4-1 1-1h11c.6 0 1 .4 1 1v7c0 .6-.4 1-1 1h-1M3 18v-7c0-.6.4-1 1-1h11c.6 0 1 .4 1 1v7c0 .6-.4 1-1 1H4a1 1 0 0 1-1-1Zm8-3.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z" />
              </svg>
              <p class="text-2xl font-medium font-color-2">User</p>
            </li>
          </ul>

          <div class="mt-4 flex items-center justify-between gap-4">
            <button type="button" class="p-4 bg-black text-white font-semibold text-2xl rounded-lg hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-gray-800" onclick="showMessage()">Sign in</button>
          </div>
        </div>
      </div>
      <!-- End of Card for Game Nights -->

    </div>
  </div>

</section>

<script>
  // Toggle the filter dropdown
  document.getElementById('filterDropdownButton').addEventListener('click', function() {
    const filterDropdown = document.getElementById('filterDropdown');
    filterDropdown.classList.toggle('hidden');
  });

  // Toggle the sort dropdown
  document.getElementById('sortDropdownButton').addEventListener('click', function() {
    const sortDropdown = document.getElementById('sortDropdown');
    sortDropdown.classList.toggle('hidden');
  });

  // Close the dropdown
  function closeDropdown(dropdownId) {
    document.getElementById(dropdownId).classList.add('hidden');
  }

  function showMessage() {
    alert('You have clicked the "Sign in" button and have been added to the Game Night!');
  }
</script>
