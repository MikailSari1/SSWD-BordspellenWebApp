<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Web</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="bg-primary text-white antialiased shadow-sm h-20 w-full">
        <div class="max-w-screen-xl px-4 mx-auto 2xl:px-0 py-4">
            <div class="flex items-left justify-between">
                <!-- Left Section (Logo + Buttons) -->
                <div class="flex items-left space-x-8 flex-grow">
                    <div class="shrink-0">
                        @* <a asp-controller="Home" asp-action="Index" title="" class="text-3xl font-bold tracking-wider pr-8 text-white">
                            <img src="@Url.Content("../Images/logo1.png")" alt="Logo" class="h-10">
                        </a> *@
                        <a asp-controller="Home" asp-action="Index" title="" class="text-3xl font-bold tracking-wider pr-8 text-white">
                            <img src="Images/logo1.png" alt="Logo" class="h-10">
                        </a>
                    </div>

                    <ul class="hidden lg:flex items-center justify-start gap-6 md:gap-8 py-3">
                        <li>
                            <a asp-controller="BoardGameNight" asp-action="Index" title="" class="flex text-2xl font-medium text-white hover:text-gray-300 tracking-wide">
                                Game Nights
                            </a>
                        </li>
                        <li class="shrink-0">
                            <a asp-controller="AcceptedBoardGameNight" asp-action="Index" title="Accepted Game Nights" class="flex text-2xl font-medium text-white hover:text-gray-300 tracking-wide">
                                Accepted Game Nights
                            </a>
                        </li>
                        <li class="shrink-0">
                            <a asp-controller="OrganizeBoardGameNight" asp-action="Index" title="Organize Game Nights" class="flex text-2xl font-medium text-white hover:text-gray-300 tracking-wide">
                                Organize Game Night
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Profile Icon Button (Right Aligned) -->
                <div class="flex items-center space-x-4">
                    <a asp-controller="Profile" asp-action="Index" title="Profile" class="relative block w-10 h-10 overflow-hidden rounded-full border-2 border-gray-300 hover:border-gray-500">
                        <img class="object-cover w-10 h-10" src="https://www.w3schools.com/w3images/avatar2.png" alt="Profile Icon">
                    </a>
                </div>
            </div>
        </div>
    </nav>




</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

 <footer class="p-6 bg-white md:p-10 lg:p-12 mt-auto">
        <div class="mx-auto max-w-screen-xl text-center">
            <a href="#" class="flex justify-center items-center text-3xl font-extrabold text-gray-900">
                <svg class="mr-2 h-10" viewBox="0 0 33 33" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <!-- SVG paths here -->
                </svg>
                Avans Board Game Night
            </a>
            <p class="font-bold my-6 text-gray-600 text-lg">
                Public website where you can enjoy all sorts of game nights with other people!
            </p>
            <ul class="flex flex-wrap justify-center items-center mb-6 text-gray-900 text-lg">
    <li>
        <a href="#" class="font-semibold mr-8 hover:underline pr-8">Home</a> <!-- Increased margin-right -->
    </li>
    <li>
        <a href="#" class="font-semibold mr-8 hover:underline pr-8">Game Nights</a> <!-- Increased margin-right -->
    </li>
    <li>
        <a href="#" class="font-semibold mr-8 hover:underline pr-8">Accepted Game Nights</a> <!-- Increased margin-right -->
    </li>
    <li>
        <a href="#" class="font-semibold mr-8 hover:underline">Organize Game Nights</a> <!-- Increased margin-right -->
    </li>
</ul>

            <span class="text-md text-gray-500 sm:text-center">
                © 2021-2022 <a href="#" class="hover:underline">ABGN</a>. All Rights Reserved.
            </span>
        </div>
    </footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>