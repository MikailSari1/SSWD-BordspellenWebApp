@{
ViewData["Title"] = "Home Page";
}

<!-- Banner -->
<div class="relative w-screen">
    <img src="@Url.Content("images/1200px-Scrabble_game_in_progress.jpg")" alt="Homepage banner" class="w-screen h-25">
    <div class="absolute inset-0 bg-black opacity-50 blur-sm"></div> <!-- Overlay for darkening and blurring -->
    <div class="absolute inset-0 flex flex-col items-center justify-center text-white text-center"> <!-- Centered text -->
        <h1 class="text-5xl font-bold mb-2">Welcome to Avans Board Game Night!</h1>
        <p class="text-2xl">Let's find more that brings us together.</p> <!-- Subtitle or additional text -->
    </div>
</div>


<!-- Section -->
<style>
    .font-color {
        color: #e3342f;
       
    }
    .font-color-2 {
         color: #0a5700;
    }
    .accessible-text {
        font-size: 1.5rem; /* Larger text for readability */
        line-height: 1.8; /* More spacing for easier reading */
        font-weight: 500; /* Medium weight for contrast */
    }
</style>
<section class="px-16">
<section class="bg-white">
    <div class="py-8 px-4 mx-auto max-w-screen-xl sm:py-16 lg:px-6 flex items-center">
        <div class="max-w-screen-md">
            <h2 class="mb-6 text-5xl tracking-tight font-extrabold font-color-2">Let's find more that brings us together.</h2>
            <p class="mb-8 font-color accessible-text">
                We are passionate about bringing people together through shared experiences. Whether it's connecting with friends, family, or meeting new people, our platform makes it easy with features like Groups, Watch, and Marketplace.
            </p>
        </div>
        <div class="ml-8 hidden md:block">
            <img src="path-to-image.jpg" alt="Community gathering" class="w-80 h-auto rounded-lg shadow-lg">
        </div>
    </div>
</section>

<section class="bg-gray-100">
    <div class="py-8 px-4 mx-auto max-w-screen-xl sm:py-16 lg:px-6 flex items-center justify-end">
        <div class="max-w-screen-md text-right">
            <h2 class="mb-6 text-5xl tracking-tight font-extrabold font-color-2">Bringing People Together with Board Games</h2>
            <p class="mb-8 font-color accessible-text">
                Board games are at the heart of what we do. From classic strategy games to modern party favorites, we provide a welcoming space for all skill levels. Whether you're a seasoned player or just starting, our community is here to help you discover, learn, and enjoy amazing games.
            </p>
            <p class="mb-8 font-color accessible-text">
                We organize game nights, tournaments, and special events to make sure everyone gets a chance to join in the fun. Come roll the dice, strategize, and connect with like-minded enthusiasts!
            </p>
        </div>
        <div class="ml-8 hidden md:block">
            <img src="path-to-boardgame-image.jpg" alt="Board games event" class="w-80 h-auto rounded-lg shadow-lg">
        </div>
    </div>
</section>

<section class="bg-white">
    <div class="py-8 px-4 mx-auto max-w-screen-xl sm:py-16 lg:px-6 flex items-center">
        <div class="max-w-screen-md">
            <h2 class="mb-6 text-5xl tracking-tight font-extrabold font-color-2">Discover New Adventures with Friends</h2>
            <p class="mb-8 font-color accessible-text">
                Life is an adventure best shared with others. Our platform is designed to help you explore new experiences, meet new people, and enjoy your favorite activities with friends. From exciting outdoor adventures to cozy game nights, we make it easy to stay connected.
            </p>
            <p class="mb-8 font-color accessible-text">
                Whether you're into hiking, cooking, gaming, or just hanging out, there’s something here for everyone. Let’s make memories together and create new adventures with every step we take.
            </p>
        </div>
        <div class="ml-8 hidden md:block">
            <img src="path-to-adventure-image.jpg" alt="Friends exploring together" class="w-80 h-auto rounded-lg shadow-lg">
        </div>
    </div>
</section>
</section>






